# R8 / Proguard rules for MPAZ Pañol TI
# Preservar entidades de Room y modelos de datos
-keep class com.example.mpazpanol.model.** { *; }

# Preservar DAOs y Base de Datos Room
-keep class com.example.mpazpanol.data.dao.** { *; }
-keep class com.example.mpazpanol.data.database.** { *; }

# Mantener atributos de reflexión, anotaciones y clases internas requeridas por KSP / Room
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod
